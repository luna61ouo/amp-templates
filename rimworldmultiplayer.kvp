App.DisplayName=RimWorld Multiplayer Server
App.RootDir=./rimworld-mp/
App.BaseDirectory=./rimworld-mp/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=Server.exe
App.ExecutableLinux=Server
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"DOTNET_ROOT":"{{$FullBaseDir}}Dotnet"}
App.CommandLineParameterFormat={0}={1}
